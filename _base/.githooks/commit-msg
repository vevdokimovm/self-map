#!/usr/bin/env python3
"""commit-msg — не пускает в сообщение коммита упоминание ассистента.

🔴 ПОЧЕМУ ОТДЕЛЬНЫЙ ХУК, А НЕ СТРОКА В `pre-commit`. `pre-commit` вызывается
ДО того, как сообщение написано, и текста коммита не видит вовсе. Трейлер
`Co-Authored-By` живёт именно в сообщении — значит поймать его может только
`commit-msg`. Класс ошибки: проверка, поставленная туда, где проверяемого
ещё не существует.

🔴 НЕ НАШЁЛ ПРОВЕРКУ — ПАДАЕТ, а не пропускает. Защита, которая при своей
поломке тихо разрешает, хуже отсутствия защиты: она создаёт уверенность.

Установка (один раз на репу):
    git config core.hooksPath .githooks
"""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path

ПРОВЕРКА = Path(__file__).resolve().parent.parent / "scripts" / "attribution_check.py"


def main() -> int:
    if len(sys.argv) < 2:
        print("🔴 commit-msg вызван без файла сообщения")
        return 1
    if not ПРОВЕРКА.is_file():
        print(f"🔴 не найдена проверка атрибуции: {ПРОВЕРКА}")
        print("   Коммит остановлен: защита сломана, и молча пропускать нельзя.")
        return 1
    res = subprocess.run(
        [sys.executable, str(ПРОВЕРКА), "--message", sys.argv[1], "--ident"],
        capture_output=True, text=True, encoding="utf-8")
    if res.returncode != 0:
        print(res.stdout or res.stderr)
        print("   Обойти осознанно: git commit --no-verify")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
