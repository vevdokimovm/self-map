#!/usr/bin/env python3
"""pre-commit — не пускает в коммит то, что потом дорого вынимать.

Проверяет только то, что реально попало в индекс (staged), и падает с понятным
объяснением, а не молча. Три класса проблем, все три уже случались:

  1. СЕКРЕТЫ  — токены, ключи, пароли. Единственное железное правило репы
                (01-repo-standard.md §2.4). В academic-portfolio так уехали живые
                VK- и Telegram-токены, и вынимать их пришлось отзывом, а не git.
  2. ТЯЖЁЛОЕ  — git хранит каждую версию бинарника навсегда. Один раз закоммитил —
                репа потолстела навсегда (06-volume-compression.md).
  3. ФОРМАТЫ  — .zip/.docx/.pptx в репе не место: распаковать и законспектировать.
  4. ДЕПЛОЙЕР — версия скрипта разошлась с документацией или с копиями на диске.
                Копия в базе три недели стояла на 4.3.2, пока рабочая ушла до 4.16.1,
                и документация всё это время называла каноном базу (PIT-063).
  5. README    — версию подняли, а README остался описывать прошлое состояние.
                README — первое, что открывает владелец, чтобы за десять секунд понять,
                что в репе происходит; обновляют его последним и забывают чаще всего
                (75-readme-status-block.md).

Установка (один раз на репу):
    git config core.hooksPath .githooks
    chmod +x .githooks/pre-commit

Обойти осознанно (когда точно знаешь, что делаешь):
    git commit --no-verify
"""

from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

PDF_LIMIT_MB = 5
IMAGE_LIMIT_MB = 0.5
FILE_LIMIT_MB = 10
BANNED_SUFFIXES = {".zip", ".rar", ".7z", ".docx", ".pptx", ".odt", ".rtf",
                   ".exe", ".o", ".bin"}
IMAGE_SUFFIXES = {".png", ".jpg", ".jpeg", ".gif", ".webp", ".tiff", ".bmp", ".heic"}
TEXT_SUFFIXES = {".md", ".py", ".txt", ".json", ".yml", ".yaml", ".sh", ".cfg",
                 ".ini", ".toml", ".env", ".js", ".ts", ".sql", ".conf"}

# Ищем присвоение значения, а не слово в тексте — иначе конспект про безопасность
# поднимет тревогу, и на третий раз хук начнут игнорировать.
SECRET_PATTERNS = [
    (re.compile(r"vk1\.a\.[A-Za-z0-9_-]{50,}"), "VK access token"),
    (re.compile(r"\b\d{8,10}:AA[A-Za-z0-9_-]{30,}\b"), "Telegram bot token"),
    (re.compile(r"\bsk-[A-Za-z0-9]{20,}\b"), "OpenAI-style API key"),
    (re.compile(r"\bghp_[A-Za-z0-9]{20,}\b"), "GitHub personal token"),
    (re.compile(r"\bxox[baprs]-[A-Za-z0-9-]{10,}\b"), "Slack token"),
    (re.compile(r"\bAKIA[0-9A-Z]{16}\b"), "AWS access key"),
    (re.compile(r"BEGIN\s+(RSA|OPENSSH|EC|PGP)\s+PRIVATE KEY"), "приватный ключ"),
    (
        re.compile(
            r"""(?:api[_-]?key|secret|password|passwd|token|access[_-]?key)\s*[:=]\s*['"]([^'"\s]{8,})['"]""",
            re.I,
        ),
        "пароль/токен в коде",
    ),
]
# Плейсхолдеры и чтение из окружения — не секреты.
SAFE_VALUE = re.compile(
    # 🔴 `change[_-]?me` С ДЕФИСОМ — найдено 13.09.2026 на живом файле.
    # `finpilot/app/config.py` объявляет подставной ключ
    # `dev-insecure-secret-change-me-in-production-env-32b`, и сканер поднял
    # тревогу: шаблон знал `change_me` и `changeme`, но не `change-me`.
    # Ложное срабатывание на безопасном значении учит обходить проверку —
    # это дороже, чем чуть более широкий список исключений (`PIT-207`).
    r"(getenv|environ|process\.env|os\.|\{\{|\$\{|<|xxx|your_|example|"
    r"placeholder|\.\.\.|change[_-]?me|dev[_-]insecure)",
    re.I,
)


def staged_files() -> list[Path]:
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        capture_output=True, text=True, check=True,
    )
    return [Path(line) for line in result.stdout.splitlines() if line.strip()]


def scan_secrets(path: Path) -> list[str]:
    if path.suffix.lower() not in TEXT_SUFFIXES:
        return []
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return []

    hits: list[str] = []
    for line_number, line in enumerate(text.splitlines(), start=1):
        for pattern, label in SECRET_PATTERNS:
            match = pattern.search(line)
            if not match:
                continue
            value = match.group(match.lastindex or 0)
            if SAFE_VALUE.search(value):
                continue
            hits.append(f"{path}:{line_number} — {label}")
            break
    return hits


def check_weight(path: Path) -> str | None:
    try:
        size_mb = path.stat().st_size / 1_048_576
    except OSError:
        return None
    suffix = path.suffix.lower()

    # 🔴 ИСКЛЮЧЕНИЕ ДЛЯ ВЫДАЧИ ПРЕЗЕНТАЦИОННОГО КИТА — узкое, по каталогу.
    # Найдено 13.09.2026 опытом на копии `quick-answers`: коммит в репе-наследнице
    # остановлен хуком на `_base/11-presentation-kit/output/ONBOARDING.docx` и `.rtf`.
    # Два правила противоречили друг другу: кит ОБЯЗАН выдавать эти форматы
    # (для этого он и существует — отдать документ людям вне репы), а хук их
    # ЗАПРЕЩАЕТ. В самой базе файлы проходили только потому, что давно
    # не менялись: первая же пересборка кита заблокировала бы и её.
    #
    # Исключён ТОЛЬКО запрет форматов и только в `16-document-kit/output/`
    # (до 14.09.2026 каталог жил в `11-presentation-kit/output/`).
    # Лимиты веса и проверка секретов действуют и здесь.
    if "16-document-kit/output/" in path.as_posix() and suffix in BANNED_SUFFIXES:
        return None

    if suffix in BANNED_SUFFIXES:
        return f"{path} — формат {suffix} в репе не место (распаковать / законспектировать)"
    if suffix in IMAGE_SUFFIXES and size_mb > IMAGE_LIMIT_MB:
        return f"{path} — картинка {size_mb:.1f} МБ (лимит {IMAGE_LIMIT_MB} МБ, сжать)"
    if suffix == ".pdf" and size_mb > PDF_LIMIT_MB:
        return f"{path} — PDF {size_mb:.1f} МБ (лимит {PDF_LIMIT_MB} МБ, сжать или в .md)"
    if size_mb > FILE_LIMIT_MB:
        return f"{path} — файл {size_mb:.1f} МБ (git хранит все версии навсегда)"
    return None


def check_deploy_version(files: list[Path]) -> int:
    """Правишь деплойер — версия и документация обязаны сойтись.

    Четвёртый класс проблем, и он тоже уже случался: копия в базе три недели стояла
    на 4.3.2, пока рабочий скрипт ушёл до 4.16.1. Гейт запускается только когда
    в коммите есть сам скрипт или его документация — на прочих коммитах молчит.
    """
    touched = {p.as_posix() for p in files}
    watched = {"templates/deploy.sh", "templates/deploy-SPEC.md",
               "templates/deploy-MODES.md", "templates/deploy-CHANGELOG.md"}
    if not (touched & watched):
        return 0

    gate = Path("scripts/deploy_version_gate.py")
    if not gate.is_file():
        return 0
    run = subprocess.run([sys.executable, str(gate)], capture_output=True, text=True)
    if run.returncode == 0:
        return 0
    print("\n🟠 ВЕРСИЯ ДЕПЛОЙЕРА РАЗОШЛАСЬ С ДОКУМЕНТАЦИЕЙ — остановлено\n")
    print(run.stdout.rstrip())
    print()
    return 1


def check_readme_status(files: list[Path]) -> int:
    """Подняли версию — README обязан ехать вместе с ней.

    Пятый класс проблем. Тихий: README читается и выглядит правдой, просто правда
    в нём трёхнедельной давности. Гейт запускается только когда в коммите есть
    VERSION или сам README — на прочих коммитах молчит.
    """
    touched = {p.as_posix() for p in files}
    if not (touched & {"VERSION", "README.md"}):
        return 0

    gate = Path("scripts/readme_status_gate.py")
    if not gate.is_file():
        return 0
    run = subprocess.run([sys.executable, str(gate), "--staged"],
                         capture_output=True, text=True)
    if run.returncode == 0:
        return 0
    print(run.stdout.rstrip())
    print()
    return 1


def main() -> int:
    files = staged_files()
    secrets: list[str] = []
    weight: list[str] = []

    for path in files:
        if not path.exists():
            continue
        secrets.extend(scan_secrets(path))
        problem = check_weight(path)
        if problem:
            weight.append(problem)

    drift = check_deploy_version(files)
    stale_readme = check_readme_status(files)

    if secrets:
        print("\n🔴 СЕКРЕТЫ В КОММИТЕ — остановлено\n")
        for hit in secrets:
            print(f"   {hit}")
        print("\n   Вынеси в .env (python-dotenv) и добавь .env в .gitignore.")
        print("   Если секрет уже уехал в историю — сначала ОТЗЫВАЙ его, потом чисти git.\n")

    if weight:
        print("\n🟡 ВЕС И ФОРМАТЫ — остановлено\n")
        for problem in weight:
            print(f"   {problem}")
        print("\n   Правила: 00-infrastructure/06-volume-compression.md")
        print("   Если файл действительно нужен: git commit --no-verify\n")

    return 1 if (secrets or weight or drift or stale_readme) else 0


if __name__ == "__main__":
    sys.exit(main())
