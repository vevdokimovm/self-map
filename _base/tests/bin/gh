#!/usr/bin/env bash
# Стаб GitHub CLI для тестов deploy.sh. Хранит состояние в $GH_STORE:
#   $GH_STORE/repos/<repo>              — файл-маркер существующей репы (внутри: visibility)
#   $GH_STORE/rel/<repo>/<tag>/title    — заголовок релиза
#   $GH_STORE/rel/<repo>/<tag>/body     — описание
#   $GH_STORE/rel/<repo>/<tag>/assets/  — ассеты
# Пишет журнал вызовов в $GH_STORE/calls.log — тесты по нему проверяют поведение.
set -u
STORE="${GH_STORE:?GH_STORE не задан}"
mkdir -p "$STORE/repos" "$STORE/rel"
echo "$*" >> "$STORE/calls.log"

# --repo owner/name -> name; иначе берём из текущей папки-клона
repo_arg() {
  local prev="" a
  for a in "$@"; do
    [ "$prev" = "--repo" ] && { printf '%s' "${a##*/}"; return; }
    prev="$a"
  done
  basename "$(pwd)"
}

case "${1:-}" in
auth) echo "Logged in to github.com as testuser"; exit 0 ;;

# 🔴 `api` ЗАВЕДЕНА 04.09.2026 — до этого её здесь НЕ БЫЛО, и стаб отвечал
# на неё общим `exit 0` с пустым выводом. «Нет такого случая» выглядело
# как «случай проверен и пуст»: предохранитель доставки в deploy.sh
# три версии подряд считался протестированным, а на живом GitHub падал
# на первой же новой репе (пустая репа отдаёт 404, а не пустой список).
#
# Отвечает как настоящий GitHub:
#   · $GH_STORE/contents/<repo> есть        → JSON-массив из его строк;
#   · bare-remote без коммитов              → 404 «This repository is empty.»
#                                             И НЕНУЛЕВОЙ КОД — как боевой gh;
#   · иначе                                 → корень дерева remote HEAD.
api)
  _path="${2:-}"
  # 🔴 `--jq` ПРИМЕНЯЕТСЯ ПО-НАСТОЯЩЕМУ, а не игнорируется. Иначе стаб
  # проверял бы не тот контракт: боевой `gh` отдаёт РЕЗУЛЬТАТ фильтра,
  # и вся логика вызывающего написана под него. Стаб, отдающий сырой JSON,
  # зеленел бы на коде, который в бою не работает.
  _jq=""; _prev=""
  for _a in "$@"; do [ "$_prev" = "--jq" ] && { _jq="$_a"; break; }; _prev="$_a"; done
  emit() {           # печатает JSON, применяя фильтр, если он задан
    if [ -n "$_jq" ]; then printf '%s' "$1" | jq -r "$_jq"; else printf '%s\n' "$1"; fi
  }
  case "$_path" in
  repos/*/contents*)
    _rest="${_path#repos/}"; _owner="${_rest%%/*}"; _rest="${_rest#*/}"
    _name="${_rest%%/*}"
    _list="$STORE/contents/$_name"
    if [ -f "$_list" ]; then
      _json='['; _first=1
      while IFS= read -r _n; do
        [ -z "$_n" ] && continue
        [ "$_first" = 1 ] || _json="$_json,"
        _json="$_json{\"name\":\"$_n\",\"type\":\"file\"}"
        _first=0
      done < "$_list"
      emit "$_json]"
      exit 0
    fi
    _bare="${REMOTE_BASE#file://}/$_name.git"
    if [ -d "$_bare" ] && ! git -C "$_bare" rev-parse HEAD >/dev/null 2>&1; then
      printf '{"message":"This repository is empty.","documentation_url":"https://docs.github.com/v3/repos/contents/#get-contents","status":"404"}\n' >&2
      exit 1
    fi
    if [ -d "$_bare" ]; then
      _json='['; _first=1
      for _n in $(git -C "$_bare" ls-tree --name-only HEAD 2>/dev/null); do
        [ "$_first" = 1 ] || _json="$_json,"
        _json="$_json{\"name\":\"$_n\",\"type\":\"file\"}"
        _first=0
      done
      emit "$_json]"
      exit 0
    fi
    exit 1 ;;
  esac
  exit 0 ;;

repo)
  case "${2:-}" in
  view)
    name="${3##*/}"; [ -f "$STORE/repos/$name" ] && exit 0 || exit 1 ;;
  create)
    name="${3##*/}"
    vis="private"; for a in "$@"; do [ "$a" = "--public" ] && vis="public"; done
    echo "$vis" > "$STORE/repos/$name"
    # боевой GitHub отдаёт пустую репу — эмулируем bare-remote
    if [ -n "${REMOTE_BASE:-}" ] && [ ! -d "${REMOTE_BASE#file://}/$name.git" ]; then
      git init -q --bare "${REMOTE_BASE#file://}/$name.git"
    fi
    exit 0 ;;
  esac ;;

release)
  sub="${2:-}"; tag="${3:-}"; name="$(repo_arg "$@")"
  d="$STORE/rel/$name/$tag"
  case "$sub" in
  view)
    [ -d "$d" ] || { echo "release not found"; exit 1; }
    for a in "$@"; do
      case "$a" in
      body)   cat "$d/body"  2>/dev/null; exit 0 ;;
      name)   cat "$d/title" 2>/dev/null; exit 0 ;;
      assets)
        for a in "$d/assets"/*; do [ -f "$a" ] || continue
          case "$*" in *size*) wc -c < "$a" | tr -d ' ' ;; *) basename "$a" ;; esac
        done
        exit 0 ;;
      esac
    done
    exit 0 ;;
  create|edit)
    [ "$sub" = "edit" ] && [ ! -d "$d" ] && exit 1
    mkdir -p "$d/assets"
    prev=""
    for a in "$@"; do
      case "$prev" in
      --title)      printf '%s' "$a" > "$d/title" ;;
      --notes-file) cp "$a" "$d/body" ;;
      --notes)      printf '%s' "$a" > "$d/body" ;;
      esac
      prev="$a"
    done
    # позиционные ассеты у create: gh release create <tag> [file...]
    if [ "$sub" = "create" ]; then
      shift 3 || true
      prev=""
      for a in "$@"; do
        case "$prev" in --*) prev="$a"; continue ;; esac   # это значение флага, не ассет
        case "$a" in --*) prev="$a"; continue ;; esac
        [ -f "$a" ] && cp "$a" "$d/assets/$(basename "$a")"
        prev="$a"
      done
    fi
    exit 0 ;;
  upload)
    [ -d "$d" ] || exit 1
    mkdir -p "$d/assets"; shift 3 || true
    prev=""
    for a in "$@"; do
      case "$prev" in --*) prev="$a"; continue ;; esac
      case "$a" in --*) prev="$a"; continue ;; esac
      [ -f "$a" ] && cp "$a" "$d/assets/$(basename "$a")"
      prev="$a"
    done
    exit 0 ;;
  delete)
    [ -d "$d" ] || exit 1
    rm -rf "$d"; exit 0 ;;
  delete-asset)
    # gh release delete-asset <tag> <asset-name>
    _asset="${4:-}"
    [ -f "$d/assets/$_asset" ] || exit 1
    rm -f "$d/assets/$_asset"; exit 0 ;;
  list)
    for t in $(ls -1 "$STORE/rel/$name" 2>/dev/null); do printf '%s\tRelease\t%s\n' "$t" "$t"; done
    exit 0 ;;
  esac ;;
esac
exit 0
